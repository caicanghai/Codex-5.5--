# EIOS development environment (EXAMPLE)
#
# Copy to deployments/.env and replace placeholders. NEVER commit a real .env.
# This file documents the SHAPE of configuration only — no real secrets.

# --- PostgreSQL ---
POSTGRES_USER=eios
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=eios
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=eios
MINIO_ROOT_PASSWORD=change_me_local_only
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Directus (placeholder, not implemented in M0) ---
DIRECTUS_SECRET=change_me_local_only
DIRECTUS_PORT=8055

# --- n8n (placeholder, not implemented in M0) ---
N8N_HOST=localhost
N8N_PORT=5678

# --- Application services (placeholders, not implemented in M0) ---
GATEWAY_PORT=8080
API_PORT=3000
