{
  "name": "eios",
  "version": "0.0.0",
  "private": true,
  "description": "EIOS — Evidence Intelligence & Omnichannel System (Milestone 0 foundation)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ./scripts/test-placeholder.mjs",
    "build": "node ./scripts/build-placeholder.mjs",
    "validate:compose": "bash ./scripts/validate-compose.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0"
  }
}
