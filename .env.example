# ============================================================================
# EIOS 配置表 — 复制成 .env 再逐项填写（docker compose 会自动读取 .env）
#     cp .env.example .env  &&  nano .env
#
# 规则：密钥只填在这里（服务器上），永远不要贴进聊天/截图。留空的项 = 该功能关闭。
#
# 各渠道「接收消息」回调地址（在对应平台后台填这个 URL，把 你的域名 换成真实域名）：
#   微信公众号   →  https://你的域名/webhook/wechat
#   企业微信     →  https://你的域名/webhook/wecom
#   WhatsApp    →  https://你的域名/webhook/whatsapp
#   OpenClaw    →  https://你的域名/webhook/openclaw
#   API 端口     →  见文件末尾 API_PORT（默认 8000；反向代理到 443）
# ============================================================================


# ============================================================
# 【必填】Telegram —— 最快跑通的渠道
# ============================================================
# 从 @BotFather 拿到的 token，格式 123456789:AA...
TELEGRAM_BOT_TOKEN=
# 你自己的 Telegram 数字 user id（用于 /voice_set /voice_pick /speak 等 owner 命令）
TELEGRAM_OWNER_ID=


# ============================================================
# 【可选】AI 大模型 — 免费优先
# 留空则用离线摘要，管线仍可端到端跑通（只是非 LLM 质量）。
# ============================================================

# 🟢 免费模型（推荐默认）
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=sk-or-v1-your_openrouter_free_key
AI_MODEL=llama-3.1-8b

# 备用（如果需要更换，取消注释下面的任一选项）
# 🔴 付费选项（按需启用）
# ① One API (本地中转网关)
# AI_BASE_URL=http://oneapi:3000/v1
# AI_API_KEY=sk-your_oneapi_key
# AI_MODEL=deepseek-chat

# ② Agnes AI (外网直连)
# AI_BASE_URL=https://apihub.agnes-ai.com/v1
# AI_API_KEY=sk-your_agnes_key
# AI_MODEL=auto

# ③ Grok (X AI)
# AI_BASE_URL=https://api.x.ai/v1
# AI_API_KEY=xai-your_grok_key
# AI_MODEL=grok-2

# ④ KIMI (智谱清言)
# AI_BASE_URL=https://api.moonshot.cn/v1
# AI_API_KEY=sk-your_kimi_key
# AI_MODEL=moonshot-v1-128k

# ⑤ OpenRouter - Tencent Hy3 (非常便宜)
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-v1-your_openrouter_cheap_key
# AI_MODEL=tencent/hy3

# 🔄 故障转移链（主 AI 失败时自动尝试备用）
# 优先级：主 AI → 备用 1 → 备用 2 → 备用 3 → 离线摘要
# AI_FALLBACK_URL=https://apihub.agnes-ai.com/v1
# AI_FALLBACK_KEY=sk-your_agnes_key
# AI_FALLBACK2_URL=https://api.moonshot.cn/v1
# AI_FALLBACK2_KEY=sk-your_kimi_key
# AI_FALLBACK3_URL=https://api.x.ai/v1
# AI_FALLBACK3_KEY=xai-your_grok_key

# 备用（接受 OPENAI_API_KEY 格式）
OPENAI_API_KEY=


# ============================================================
# 【语音】音色 —— 合成顺序 Fish → ElevenLabs → Edge
# 选定音色用 /voice_list 看列表、/voice_pick <编号> 选；选定后全渠道回复都用它。
# ============================================================
TTS_PROVIDER=fish
# Edge 兜底默认音色（免密钥；示例：zh-CN-XiaoxiaoNeural / en-US-AriaNeural）
TTS_VOICE=zh-CN-XiaoxiaoNeural

# --- Fish Audio（主力，支持克隆 + 精选音色）---
FISH_AUDIO_API_KEY=
FISH_AUDIO_BASE_URL=https://api.fish.audio
# 默认 Fish 音色/模型 id（fish.audio 链接里的 modelId）。也可留空改用 /voice_pick 选。
FISH_AUDIO_VOICE_ID=

# --- ElevenLabs（备用，高质量通用 TTS）---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- 语音样本约束（/voice_set 上传克隆样本时用）---
VOICE_MIN_DURATION_SECONDS=15
VOICE_MAX_DURATION_SECONDS=90
VOICE_MAX_UPLOAD_MB=20
VOICE_SAMPLE_RETENTION=false


# ============================================================
# 【多渠道】投递优先级：telegram > wecom > wechat_official > whatsapp > openclaw
# 下面这行是「实际投递到哪些渠道」的逗号列表（要接哪个就加进来）：
# ============================================================
CHANNELS_ENABLED=telegram


# --- 企业微信 WeCom（自建应用，官方 API）--------------------------------------
WECOM_ENABLED=false
# 发消息 needed：企业后台 → 我的企业(CorpID) / 应用(AgentId+Secret)
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
# 收消息 needed（要 EIOS 能回复你，必填这两项）：应用 → 接收消息 → API 接收
#   Token / EncodingAESKey（AES key 为 43 位）。回调 URL 填 /webhook/wecom
WECOM_TOKEN=
WECOM_AES_KEY=
# 默认发给谁（留空 = @all）；也可填部门/标签
WECOM_TARGET_USER=
WECOM_TARGET_PARTY=
WECOM_TARGET_TAG=
WECOM_BASE_URL=https://qyapi.weixin.qq.com


# --- 微信公众号 WeChat Official Account（官方 API）----------------------------
WECHAT_OFFICIAL_ENABLED=false
# 发消息 needed：公众平台 → 开发信息 AppID / AppSecret
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 收消息 needed：服务器配置 Token；安全/兼容模式再填 EncodingAESKey（43 位）
#   回调 URL 填 /webhook/wechat（明文模式可只填 Token，AES key 留空）
WECHAT_TOKEN=
WECHAT_AES_KEY=
WECHAT_BASE_URL=https://api.weixin.qq.com


# --- WhatsApp Business（Meta 官方 Cloud API）--------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# 你自定义的校验字符串，与 Meta 后台 Webhook 里填的一致；回调 URL /webhook/whatsapp
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_RECIPIENT=
WHATSAPP_BASE_URL=https://graph.facebook.com/v20.0


# --- OpenClaw（openclaw-weixin 外部微信桥）----------------------------------
OPENCLAW_ENABLED=false
OPENCLAW_BASE_URL=
OPENCLAW_API_KEY=
OPENCLAW_MODEL=openclaw-weixin
OPENCLAW_SESSION=
OPENCLAW_TARGET=


# ============================================================
# 【基础设施】数据库 / API 端口
# ============================================================
POSTGRES_USER=eios
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=eios
# api 容器监听端口（反向代理把 https://你的域名 → 此端口）
API_PORT=8000
