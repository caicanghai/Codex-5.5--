# ============ 接入清单：把下面的值填好，改名为 .env 即可 ============
# 全部可选：填了哪个，哪个渠道/来源就生效；没填的自动跳过，不影响其他。
# .env 已被 .gitignore 忽略，不会提交到仓库。

# ---- LLM 摘要（可选，强烈建议）----
# 不填也能跑：会用文章原始摘要代替 AI 摘要。
# 申请：https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ---- Telegram 采集（读频道，Telethon 用户端）----
# 在 https://my.telegram.org 申请 API_ID / API_HASH。首次运行需登录一次。
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ---- Telegram Bot 推送到群（把每日重点发进一个 TG 群）----
# 1) 找 @BotFather 创建 bot 拿 token
# 2) 新建一个群，把 bot 拉进群（发言权限打开）
# 3) 群里随便发一条消息，再访问
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    找到 "chat":{"id":-100xxxxxxxxxx} —— 这个负数就是群的 CHAT_ID
# 提示：若 getUpdates 看不到群消息，把 bot 设为群管理员，或关闭 BotFather 里的 Group Privacy
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- 个人微信群推送（wechaty 网关，需微信小号，有封号风险）----
# 你的场景：推到平时用的个人微信群。步骤：
# 1) docker compose up -d 会起 wechaty 网关，日志里出现二维码
# 2) 用一个微信【小号】扫码登录（别用主号！），并把这个小号拉进目标群
# 3) 填下面两项：
#    - WECHATY_ENDPOINT: 网关地址，docker 部署填 http://wechaty:8788
#    - WECHAT_GROUP_TOPIC: 目标群的【群名称】（要和微信里显示的完全一致）
WECHATY_ENDPOINT=http://wechaty:8788
WECHAT_GROUP_TOPIC=
# 登录不上时（个人微信 web 协议常被限），换 padlocal 付费 token：
#   WECHATY_PUPPET=wechaty-puppet-padlocal
#   WECHATY_PUPPET_PADLOCAL_TOKEN=你的token

# ---- 企业微信群机器人（你用不了企业微信，默认留空即可）----
WECOM_WEBHOOK=

# ---- Server酱推送（转发到你个人微信）----
# 在 https://sct.ftqq.com 登录后拿 SendKey
SERVERCHAN_KEY=
