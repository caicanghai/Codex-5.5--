# EIOS MVP — copy to .env and fill in.  (docker compose reads .env automatically)

# REQUIRED: Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# OPTIONAL: AI summarization (OpenAI-compatible). If empty, an offline
# extractive summarizer is used so the pipeline still works.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# OPTIONAL: TTS voice (edge-tts). Examples: en-US-AriaNeural, en-GB-RyanNeural
TTS_VOICE=en-US-AriaNeural

# OPTIONAL: Postgres credentials / port
POSTGRES_USER=eios
POSTGRES_PASSWORD=eios
POSTGRES_DB=eios
API_PORT=8000
