# EIOS MVP — copy to .env and fill in.  (docker compose reads .env automatically)
#   cp .env.example .env  &&  nano .env

# ============================================================
# REQUIRED
# ============================================================
# Telegram bot token from @BotFather (format: 123456789:AA...)
TELEGRAM_BOT_TOKEN=

# ============================================================
# OPTIONAL — AI summarization (OpenAI-compatible endpoint)
# If left empty, an offline extractive summarizer is used and the
# pipeline still works end to end (just non-LLM quality).
# Accepts OPENAI_API_KEY or AI_API_KEY.
# ============================================================
OPENAI_API_KEY=
# For non-OpenAI providers (DeepSeek, OpenRouter, etc.) set the base URL + model:
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ============================================================
# OPTIONAL — TTS voice (edge-tts fallback). Examples:
#   en-US-AriaNeural, en-GB-RyanNeural, zh-CN-XiaoxiaoNeural
# ============================================================
TTS_VOICE=en-US-AriaNeural

# ============================================================
# OWNER-ONLY VOICE (Phase 2). Provider order: Fish -> ElevenLabs -> Edge.
# ============================================================
# Telegram numeric user id allowed to use /voice_set /voice_status /voice_delete /speak
TELEGRAM_OWNER_ID=
TTS_PROVIDER=fish
# Fish Audio (primary, voice cloning)
FISH_AUDIO_API_KEY=
FISH_AUDIO_BASE_URL=https://api.fish.audio
FISH_AUDIO_VOICE_ID=
# ElevenLabs (fallback)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Voice sample constraints
VOICE_MIN_DURATION_SECONDS=15
VOICE_MAX_DURATION_SECONDS=90
VOICE_MAX_UPLOAD_MB=20
VOICE_SAMPLE_RETENTION=false

# ============================================================
# OPTIONAL — Postgres credentials / API port
# ============================================================
POSTGRES_USER=eios
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=eios
API_PORT=8000
