# ============ 接入清单：把下面的值填好，改名为 .env 即可 ============
# 全部可选：填了哪个，哪个渠道/来源就生效；没填的自动跳过，不影响其他。
# .env 已被 .gitignore 忽略，不会提交到仓库。

# ---- LLM 摘要（可选，强烈建议）----
# 不填也能跑：会用文章原始摘要代替 AI 摘要。
# 申请：https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ---- Telegram 采集（读频道，Telethon 用户端）----
# 在 https://my.telegram.org 申请 API_ID / API_HASH。首次运行需登录一次。
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ---- Telegram Bot 推送（把每日重点发给你，最稳，推荐先接这个）----
# 1) 找 @BotFather 创建 bot 拿 token
# 2) 给你的 bot 发一句话，再访问
#    https://api.telegram.org/bot<TOKEN>/getUpdates 里的 chat.id 就是 CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- 企业微信群机器人推送（官方，稳定）----
# 企业微信群 -> 添加群机器人 -> 复制 Webhook 地址，整段粘贴到这里
WECOM_WEBHOOK=

# ---- Server酱推送（转发到你个人微信）----
# 在 https://sct.ftqq.com 登录后拿 SendKey
SERVERCHAN_KEY=
