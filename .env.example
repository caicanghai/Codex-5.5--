# ============ 接入清单：把下面的值填好，改名为 .env 即可 ============
# 全部可选：填了哪个，哪个渠道/来源就生效；没填的自动跳过，不影响其他。
# .env 已被 .gitignore 忽略，不会提交到仓库。

# ---- LLM 摘要（可选，强烈建议）----
# 不填也能跑：会用文章原始摘要代替 AI 摘要。
# 申请：https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ---- Telegram 采集（读频道，Telethon 用户端）----
# 在 https://my.telegram.org 申请 API_ID / API_HASH。首次运行需登录一次。
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ---- Telegram Bot 推送到群（把每日重点发进一个 TG 群）----
# 1) 找 @BotFather 创建 bot 拿 token
# 2) 新建一个群，把 bot 拉进群（发言权限打开）
# 3) 群里随便发一条消息，再访问
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    找到 "chat":{"id":-100xxxxxxxxxx} —— 这个负数就是群的 CHAT_ID
# 提示：若 getUpdates 看不到群消息，把 bot 设为群管理员，或关闭 BotFather 里的 Group Privacy
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- 企业微信群机器人推送到群（官方，稳定，推荐微信侧用这个）----
# 注意：官方机器人只能推到「企业微信」的群，不是平时用的个人微信群。
# 下载企业微信 App -> 拉一个群 -> 群右上 … -> 群机器人 -> 添加 -> 复制 Webhook 地址
WECOM_WEBHOOK=

# ---- Server酱推送（转发到你个人微信）----
# 在 https://sct.ftqq.com 登录后拿 SendKey
SERVERCHAN_KEY=
